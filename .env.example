# ─────────────────────────────────────────────────────────────────────────────
# DECOMMISSIONED — 2026-07-24
# This Cloudflare Worker relay has been retired. The trading bot
# (Garden-Angel-Terminal) now runs standalone on AWS, talking directly to
# RPC/Jupiter/Telegram, and no longer depends on this Worker for price relay,
# trade confirmation, dashboard remote control, or Telegram proxying. This
# repo is kept for historical/audit reference only — do not redeploy without
# first confirming with the operator.
# ─────────────────────────────────────────────────────────────────────────────

# ─────────────────────────────────────────────────────────────────────────────
# Garden Angel — Worker environment template
# ─────────────────────────────────────────────────────────────────────────────
# Copy to `.env` (git-ignored) for local dev, or set each of these as a
# Cloudflare Worker secret (`wrangler secret put <NAME>`) / plain var in
# wrangler.toml for deployment. NEVER commit real values.
#
# SECURITY NOTES
#   • PRIVATE_KEY and PAYOUT_PASSWORD are secrets — use `wrangler secret put`,
#     not `[vars]` in wrangler.toml (vars are stored in plaintext).
#   • Every destination the bot can move funds to is derived from these vars.
#     There are NO hardcoded recipient addresses anywhere in the source.
#     PAYOUT_RECIPIENT (below) is the only place a payout destination is set;
#     leave it unset to pay back to the signing wallet's own address.
#   • Deploy the ArbitrageEngine / GasPaymaster contracts YOURSELF so your
#     wallet is their `owner`, then verify the deployed bytecode matches
#     contracts/*.sol. A contract address handed to you by a third party is
#     outside the scope of this repo's source audit.
# ─────────────────────────────────────────────────────────────────────────────

# ── Signing wallet (REQUIRED) ────────────────────────────────────────────────
# Hot wallet that signs arbitrage + payout transactions. 0x-prefixed 32-byte key.
PRIVATE_KEY=0x

# ── On-chain contracts (REQUIRED for live execution) ─────────────────────────
# Addresses of YOUR deployed contracts (you must be their owner).
ARBITRAGE_ENGINE_CONTRACT=0x
GAS_PAYMASTER_CONTRACT=0x

# ── Payout (REQUIRED for /payout) ────────────────────────────────────────────
# Plaintext password gate for the /payout Telegram command (hashed at compare).
PAYOUT_PASSWORD=
# Optional: cold-wallet address that GasPaymaster.payout() releases funds to.
# Leave UNSET to send to the signing wallet's own address.
PAYOUT_RECIPIENT=

# ── Telegram control surface (REQUIRED) ──────────────────────────────────────
TELEGRAM_BOT_TOKEN=

# ── RPC endpoints (STRONGLY RECOMMENDED — public defaults are rate-limited) ───
ETH_RPC_PRIMARY=
ETH_RPC_SECONDARY=
BSC_RPC_PRIMARY=
BSC_RPC_SECONDARY=
UNICHAIN_RPC_URL=

# ── Price oracle API (optional) ──────────────────────────────────────────────
# If set, the /prices and /execute-signal routes require X-API-Key: <this>.
# Note: /execute-signal is disabled unless this is set (it fails closed).
ORACLE_API_KEY=

# ── Relay auth (REQUIRED for the Telegram relay route) ───────────────────────
# Gates /bot<token>/<method> (src/index.js v18.1) — without it, that route
# returns 503 rather than running as an open relay for anyone's bot token.
# Must be the SAME value as the Hugging Face bot's own RELAY_AUTH_TOKEN env
# var (it already sends this as `Authorization: Bearer <token>` to every
# Telegram proxy route — see Garden-Angel-Terminal's telegram_client.py /
# report_channel.py). Note: everything below this section of the file
# (PRIVATE_KEY, contracts, PAYOUT_*, TELEGRAM_BOT_TOKEN, RPC vars) predates
# the v18.0 "keyless" rewrite of src/index.js and is no longer read by it.
RELAY_AUTH_TOKEN=

# ── Execution mode ───────────────────────────────────────────────────────────
# "true" = paper trading (no broadcasts). Anything else = LIVE. Start with true.
DRY_RUN=true

# ── Strategy tuning (optional — sensible defaults live in constants.js) ───────
# MIN_NET_PROFIT_USD=10
# UNISWAP_ROUTER=0x
